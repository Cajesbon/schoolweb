# ---------- Server ----------
NODE_ENV=production
PORT=3000
# Public address of the site (used in emails and notification links)
SITE_URL=https://www.yourschool.com

# ---------- Database (MongoDB Atlas free tier works well) ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/school?retryWrites=true&w=majority

# ---------- Security ----------
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# First administrator. Created automatically on first start if no admin exists.
ADMIN_EMAIL=admin@yourschool.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=School Administrator

# ---------- Cloudinary (image storage) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (SMTP) - admissions and contact messages are sent here ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Your School Website <no-reply@yourschool.com>"
# Fallback inbox if no recipient is set in Admin > Contact Information
SCHOOL_EMAIL=info@yourschool.com

# ---------- Browser notifications (Web Push) ----------
# Generate with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@yourschool.com
